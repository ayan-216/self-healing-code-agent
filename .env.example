# Platform Settings
PROJECT_NAME="Autonomous Self-Healing Agent Platform"
ENV="development"
LOG_LEVEL="INFO"

# Database Connection
# SQLite for local dev; PostgreSQL string in production (e.g. postgresql://user:pass@localhost:5432/db)
DATABASE_URL="sqlite:///./platform.db"

# Queue Connections
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# LLM Configuration (OpenAI / Local Mock)
OPENAI_API_KEY="your_openai_api_key_here"
DEFAULT_LLM_MODEL="gpt-4o"
USE_MOCK_LLM=true

# Vector Database (Pinecone or Local Memory Fallback)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_ENVIRONMENT=""
PINECONE_INDEX_NAME="code-audit-memory"
USE_LOCAL_VECTOR_STORE=true

# GitHub Integration & Webhooks
GITHUB_TOKEN="your_github_token_here"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_here"

# LangSmith Observability Telemetry
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langchain_api_key_here"
LANGCHAIN_PROJECT="autonomous-code-audit-platform"

# Sandbox Execution Boundaries
SANDBOX_TIMEOUT_SECONDS=60
MAX_RETRY_ATTEMPTS=3
